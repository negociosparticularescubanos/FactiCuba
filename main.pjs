$meta
  title = FactiCuba — Estudio de Factibilidad de Negocios en Cuba (En vivo)
  shortTitle = FactiCuba
  description = App datos en vivo BCC + elToque + Revolico para estudios de factibilidad en Cuba: 168 municipios, PDL/MIPYME/TCP/CNA, tributos ONAT, punto de equilibrio, PRI, flujo a 3 años y dictamen automatizado.
  tags = cuba, factibilidad, mipymes, pdl, tcp, negocios, onat, online, tasas, revolico

